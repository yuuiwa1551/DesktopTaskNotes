<Window x:Class="DesktopTaskNotes.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="250" Height="252" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="TrayActionStyle" TargetType="Button">
      <Setter Property="Height" Value="43" />
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#F1F3F6" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E5E8ED" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="10" Background="#FCFFFFFF" BorderBrush="#1F0F172A" BorderThickness="1"
          CornerRadius="14" Effect="{StaticResource CardShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="57" />
        <RowDefinition Height="1" />
        <RowDefinition Height="44" />
        <RowDefinition Height="44" />
        <RowDefinition Height="44" />
        <RowDefinition Height="1" />
        <RowDefinition Height="44" />
      </Grid.RowDefinitions>

      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentBrush}"
                VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="桌面事项贴" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="正在后台运行" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="#EEF0F3" />
      <Button Grid.Row="2" Style="{StaticResource TrayActionStyle}" Click="OpenManager_Click">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="打开管理中心" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <Button Grid.Row="3" Style="{StaticResource TrayActionStyle}" Click="NewChecklist_Click">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="新建清单贴" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <Button Grid.Row="4" Style="{StaticResource TrayActionStyle}" Click="NewProject_Click">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="新建项目贴" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <Border Grid.Row="5" Background="#EEF0F3" />
      <Button Grid.Row="6" Style="{StaticResource TrayActionStyle}" Foreground="#C4322B" Click="Exit_Click">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center"
                     Foreground="#C4322B" />
          <TextBlock Grid.Column="1" Text="退出桌面事项贴" VerticalAlignment="Center" Foreground="#C4322B" />
        </Grid>
      </Button>
    </Grid>
  </Border>
</Window>
