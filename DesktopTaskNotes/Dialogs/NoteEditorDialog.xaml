<Window x:Class="DesktopTaskNotes.Dialogs.NoteEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="便利贴设置" Width="440" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI">
  <Window.Resources>
    <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="8"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="White" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="#D8DAF8" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ColorRadioStyle" TargetType="RadioButton">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10"
                    BorderBrush="#20FFFFFF" BorderThickness="1">
              <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                         FontSize="14" Foreground="#675F53" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Visibility="Collapsed" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#80FFFFFF" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#756B5E" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="26,22,26,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="便利贴设置" FontSize="20" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock Text="一张贴只保留一个明确用途" Margin="0,4,0,0" FontSize="12"
                 Foreground="{StaticResource TextSecondaryBrush}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,14">
      <TextBlock Text="标题" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBox x:Name="TitleBox" Margin="0,7,0,0" MaxLength="80"
               AutomationProperties.Name="便利贴标题" />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,14">
      <TextBlock Text="类型" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <Border Margin="0,7,0,0" Padding="3" Background="#ECEFF3" CornerRadius="10"
              HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="ChecklistRadio" GroupName="NoteKind" Content="清单贴"
                       Style="{StaticResource SegmentRadioStyle}" IsChecked="True"
                       Checked="Type_Checked" />
          <RadioButton x:Name="ProjectRadio" GroupName="NoteKind" Content="项目贴"
                       Style="{StaticResource SegmentRadioStyle}" Checked="Type_Checked" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,0,0,14">
      <TextBlock Text="颜色" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
        <RadioButton x:Name="YellowRadio" GroupName="NoteColor" Tag="#FFF2A8" Background="#FFF2A8"
                     ToolTip="暖黄" AutomationProperties.Name="暖黄" IsChecked="True"
                     Style="{StaticResource ColorRadioStyle}" />
        <RadioButton x:Name="MintRadio" GroupName="NoteColor" Tag="#D9F2E6" Background="#D9F2E6"
                     ToolTip="薄荷" AutomationProperties.Name="薄荷"
                     Style="{StaticResource ColorRadioStyle}" />
        <RadioButton x:Name="PinkRadio" GroupName="NoteColor" Tag="#FFDDE4" Background="#FFDDE4"
                     ToolTip="粉樱" AutomationProperties.Name="粉樱"
                     Style="{StaticResource ColorRadioStyle}" />
        <RadioButton x:Name="PurpleRadio" GroupName="NoteColor" Tag="#E9E0FF" Background="#E9E0FF"
                     ToolTip="薰衣草" AutomationProperties.Name="薰衣草"
                     Style="{StaticResource ColorRadioStyle}" />
        <RadioButton x:Name="BlueRadio" GroupName="NoteColor" Tag="#DDEEFF" Background="#DDEEFF"
                     ToolTip="天空" AutomationProperties.Name="天空"
                     Style="{StaticResource ColorRadioStyle}" />
        <RadioButton x:Name="GrayRadio" GroupName="NoteColor" Tag="#F0F1F3" Background="#F0F1F3"
                     ToolTip="灰白" AutomationProperties.Name="灰白"
                     Style="{StaticResource ColorRadioStyle}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="4" x:Name="DuePanel" Visibility="Collapsed">
      <TextBlock Text="项目截止日期（可选）" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}" />
      <DatePicker x:Name="DueDatePicker" Margin="0,7,0,0"
                  AutomationProperties.Name="项目截止日期" />
    </StackPanel>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Width="82" IsCancel="True" />
      <Button Content="保存" Width="82" IsDefault="True" Click="Save_Click"
              Style="{StaticResource PrimaryButtonStyle}" />
    </StackPanel>
  </Grid>
</Window>
