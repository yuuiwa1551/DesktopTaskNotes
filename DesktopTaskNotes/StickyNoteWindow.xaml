<Window x:Class="DesktopTaskNotes.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面事项贴" Width="340" Height="430" MinWidth="280" MinHeight="220"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="NoteMenuRowStyle" TargetType="Button">
      <Setter Property="Height" Value="45" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#292D32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RowSurface" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="#F2F4F7" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="#E7EAF0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NoteColorButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="#7AFFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="SwatchSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SwatchSurface" Property="BorderThickness" Value="2" />
                <Setter TargetName="SwatchSurface" Property="BorderBrush" Value="#CCFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="NoteBorder" Background="#FFF2A8" BorderBrush="#26000000" BorderThickness="1"
          CornerRadius="14" Padding="10" Effect="{StaticResource CardShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid x:Name="Header" Height="44" Background="Transparent" Cursor="SizeAll"
            MouseLeftButtonDown="Header_MouseLeftButtonDown"
            MouseEnter="Header_MouseEnter" MouseLeave="Header_MouseLeave">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#2D2922"
                   Padding="4,2" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsHitTestVisible="False" />
        <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" Opacity="0.48">
          <Button x:Name="PinButton" Content="&#xE718;" Style="{StaticResource IconButtonStyle}"
                  AutomationProperties.Name="始终置顶"
                  ToolTip="始终置顶" Click="PinButton_Click" />
          <Button x:Name="CollapseButton" Content="&#xE70D;" Style="{StaticResource IconButtonStyle}"
                  AutomationProperties.Name="折叠或展开"
                  ToolTip="折叠/展开" Click="CollapseButton_Click" />
          <Button Content="&#xE921;" Style="{StaticResource IconButtonStyle}"
                  AutomationProperties.Name="最小化"
                  ToolTip="最小化到任务栏" Click="MinimizeButton_Click" />
          <Button x:Name="MoreButton" Content="&#xE712;" Style="{StaticResource IconButtonStyle}"
                  AutomationProperties.Name="更多操作"
                  ToolTip="更多" Click="MoreButton_Click" />
        </StackPanel>
      </Grid>

      <Grid x:Name="CollapsedSummary" Grid.Row="1" Margin="5,1,5,5" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="已折叠" FontSize="11" Foreground="#887F72" VerticalAlignment="Center" />
        <TextBlock x:Name="CollapsedStatusText" Grid.Column="1" FontSize="11" Foreground="#6F675C"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>

      <Grid x:Name="ProjectPanel" Grid.Row="1" Margin="5,0,5,8" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ProgressBar x:Name="ProjectProgress" Height="5" Minimum="0" Maximum="100"
                     Foreground="#5B5BD6" Background="#50FFFFFF" BorderThickness="0" VerticalAlignment="Center" />
        <TextBlock x:Name="ProjectProgressText" Grid.Column="1" Margin="10,0,0,0" FontSize="11"
                   Foreground="#756C5E" FontWeight="SemiBold" />
      </Grid>

      <ScrollViewer x:Name="ItemsScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Margin="0,1">
        <ItemsControl x:Name="ItemsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="TaskRow" Tag="{Binding Id}" AllowDrop="True" Padding="7,5" Margin="1,3"
                      CornerRadius="9" Drop="TaskRow_Drop">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#42FFFFFF" />
                    <Setter Property="BorderBrush" Value="#18FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#78FFFFFF" />
                        <Setter Property="BorderBrush" Value="#48FFFFFF" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="⠿" Width="17" Margin="0,0,5,0" VerticalAlignment="Center"
                             Foreground="#80786C" FontSize="15" Cursor="SizeAll" ToolTip="拖动排序"
                             AutomationProperties.Name="拖动待办排序"
                             PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="DragHandle_PreviewMouseMove" />
                  <CheckBox Grid.Column="1" Style="{StaticResource RoundCheckBoxStyle}"
                            IsChecked="{Binding IsCompleted, Mode=OneWay}" VerticalAlignment="Center" Margin="2,0,8,0"
                            AutomationProperties.Name="标记待办完成"
                            Checked="TaskCheckBox_Changed" Unchecked="TaskCheckBox_Changed" />
                  <TextBox Grid.Column="2" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                           LostKeyboardFocus="TaskText_LostKeyboardFocus">
                    <TextBox.Style>
                      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Foreground" Value="#312D26" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="2,4" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="FontSize" Value="13" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                            <Setter Property="TextDecorations" Value="Strikethrough" />
                            <Setter Property="Foreground" Value="#8C8478" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border x:Name="AddPanel" Grid.Row="3" Margin="1,8,1,4" Background="#A6FFFFFF"
              BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="NewItemPlaceholder" Text="输入待办，按 Enter 添加" Margin="13,0,0,0"
                     Foreground="#8A8174" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBox x:Name="NewItemBox" ToolTip="输入待办，按 Enter 添加" KeyDown="NewItemBox_KeyDown"
                   TextChanged="NewItemBox_TextChanged" AutomationProperties.Name="新增待办"
                   MaxLength="300" Background="Transparent" BorderThickness="0" Margin="2" Padding="9,5" />
          <Button Grid.Column="1" Content="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13"
                  Style="{StaticResource PrimaryButtonStyle}" ToolTip="添加待办" Click="AddItem_Click"
                  AutomationProperties.Name="添加待办"
                  Width="32" Height="32" Padding="0" Margin="3,3,4,3" />
        </Grid>
      </Border>

      <Grid x:Name="Footer" Grid.Row="4" Margin="5,3,2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" FontSize="11" Foreground="#786F61" VerticalAlignment="Center" />
        <Button x:Name="UndoButton" Grid.Column="1" Content="撤销" Visibility="Collapsed"
                Height="28" Padding="8,0" FontSize="11" Click="UndoButton_Click"
                Background="#55FFFFFF" BorderBrush="#30FFFFFF" />
        <Button Grid.Column="2" Content="清理已完成" Height="28" Padding="8,0" FontSize="11"
                Click="ClearCompleted_Click" Background="#55FFFFFF" BorderBrush="#30FFFFFF" />
      </Grid>

      <!-- Single-level action sheet inspired by Windows Sticky Notes. -->
      <Grid x:Name="MorePanel" Grid.Row="1" Grid.RowSpan="4" Panel.ZIndex="20" Visibility="Collapsed">
        <Border Background="#280F172A" MouseLeftButtonDown="MoreBackdrop_MouseLeftButtonDown" />
        <Border VerticalAlignment="Top" Background="#FEFFFFFF" BorderBrush="#180F172A"
                BorderThickness="1" CornerRadius="12" Effect="{StaticResource CardShadow}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="54" />
              <RowDefinition Height="1" />
              <RowDefinition Height="49" />
              <RowDefinition Height="49" />
              <RowDefinition Height="49" />
            </Grid.RowDefinitions>

            <Grid Margin="5,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="YellowSwatch" Tag="#FFF2A8" ToolTip="暖黄" Background="#FFF2A8"
                      Style="{StaticResource NoteColorButtonStyle}" Click="ColorSwatch_Click">
                <TextBlock x:Name="YellowCheck" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14" />
              </Button>
              <Button x:Name="MintSwatch" Grid.Column="1" Tag="#D9F2E6" ToolTip="薄荷" Background="#D9F2E6"
                      Style="{StaticResource NoteColorButtonStyle}" Click="ColorSwatch_Click">
                <TextBlock x:Name="MintCheck" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14" />
              </Button>
              <Button x:Name="PinkSwatch" Grid.Column="2" Tag="#FFDDE4" ToolTip="粉樱" Background="#FFDDE4"
                      Style="{StaticResource NoteColorButtonStyle}" Click="ColorSwatch_Click">
                <TextBlock x:Name="PinkCheck" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14" />
              </Button>
              <Button x:Name="PurpleSwatch" Grid.Column="3" Tag="#E9E0FF" ToolTip="薰衣草" Background="#E9E0FF"
                      Style="{StaticResource NoteColorButtonStyle}" Click="ColorSwatch_Click">
                <TextBlock x:Name="PurpleCheck" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14" />
              </Button>
              <Button x:Name="BlueSwatch" Grid.Column="4" Tag="#DDEEFF" ToolTip="天空" Background="#DDEEFF"
                      Style="{StaticResource NoteColorButtonStyle}" Click="ColorSwatch_Click">
                <TextBlock x:Name="BlueCheck" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14" />
              </Button>
              <Button x:Name="GraySwatch" Grid.Column="5" Tag="#F0F1F3" ToolTip="灰白" Background="#F0F1F3"
                      Style="{StaticResource NoteColorButtonStyle}" Click="ColorSwatch_Click">
                <TextBlock x:Name="GrayCheck" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14" />
              </Button>
            </Grid>

            <Border Grid.Row="1" Background="#EEF0F3" />

            <Button Grid.Row="2" Style="{StaticResource NoteMenuRowStyle}" Click="EditNoteMenu_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15"
                           VerticalAlignment="Center" Foreground="#596273" />
                <TextBlock Grid.Column="1" Text="便利贴设置" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="标题、类型与截止日期" VerticalAlignment="Center"
                           FontSize="11" Foreground="#8A93A2" />
              </Grid>
            </Button>

            <Button Grid.Row="3" Style="{StaticResource NoteMenuRowStyle}" Click="HideNoteMenu_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="15"
                           VerticalAlignment="Center" Foreground="#596273" />
                <TextBlock Grid.Column="1" Text="暂时隐藏" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button Grid.Row="4" Style="{StaticResource NoteMenuRowStyle}" Foreground="#C4322B"
                    Click="DeleteNoteMenu_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="15"
                           VerticalAlignment="Center" Foreground="#C4322B" />
                <TextBlock Grid.Column="1" Text="移到回收站" VerticalAlignment="Center" Foreground="#C4322B" />
              </Grid>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
