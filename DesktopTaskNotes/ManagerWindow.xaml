<Window x:Class="DesktopTaskNotes.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面事项贴 · 管理中心" Width="1040" Height="680" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="10,0,4,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="310" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource AccentBrush}" Margin="0,0,13,0">
          <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="桌面事项贴" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="把今天放在眼前，把长期任务稳稳推进" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
        </StackPanel>
      </StackPanel>
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" MinHeight="40" Padding="38,7,12,7" Margin="0"
                 ToolTip="搜索便利贴、待办和备注" TextChanged="SearchBox_TextChanged" />
        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="15" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                   IsHitTestVisible="False" />
      </Grid>
    </Grid>

    <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource SideNavTabControlStyle}"
                SelectionChanged="MainTabs_SelectionChanged">
      <TabItem Header="当前便利贴" Tag="&#xE80F;" Style="{StaticResource SideNavTabStyle}">
        <Grid Margin="26,22,26,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Text="当前便利贴" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="管理正在桌面使用的清单与项目" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Content="新建清单贴" Click="NewChecklist_Click" Style="{StaticResource PrimaryButtonStyle}" />
              <Button Content="新建项目贴" Click="NewProject_Click" />
              <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Width="36" Padding="0" ToolTip="刷新" Click="Refresh_Click" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  CornerRadius="11" ClipToBounds="True" Background="White">
            <Grid>
              <DataGrid x:Name="NotesGrid" MouseDoubleClick="NotesGrid_MouseDoubleClick"
                        SelectionChanged="GridSelection_Changed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*" />
                  <DataGridTextColumn Header="类型" Binding="{Binding KindDisplay}" Width="90" />
                  <DataGridTextColumn Header="未完成" Binding="{Binding ActiveCount}" Width="80" />
                  <DataGridTextColumn Header="已勾选" Binding="{Binding CompletedCount}" Width="80" />
                  <DataGridTextColumn Header="显示状态" Binding="{Binding VisibilityDisplay}" Width="94" />
                  <DataGridTextColumn Header="窗口模式" Binding="{Binding ModeDisplay}" Width="104" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="NotesEmptyState" Text="还没有便利贴，先从右上角新建一张"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"
                         IsHitTestVisible="False" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ShowNoteButton" Content="显示到桌面" Click="ShowNote_Click" />
            <Button x:Name="HideNoteButton" Content="暂时隐藏" Click="HideNote_Click" />
            <Button x:Name="EditNoteButton" Content="编辑设置" Click="EditNote_Click" />
            <Button x:Name="DeleteNoteButton" Content="移到回收站" Click="DeleteNote_Click" Style="{StaticResource DangerButtonStyle}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="全部待办" Tag="&#xE9D5;" Style="{StaticResource SideNavTabStyle}">
        <Grid Margin="26,22,26,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="全部待办" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="跨便利贴查看仍在推进的事项" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
          </StackPanel>
          <Border Grid.Row="1" Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  CornerRadius="11" ClipToBounds="True" Background="White">
            <Grid>
              <DataGrid x:Name="ItemsGrid" MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                        SelectionChanged="GridSelection_Changed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="便利贴" Binding="{Binding NoteTitle}" Width="180" />
                  <DataGridTextColumn Header="待办" Binding="{Binding Text}" Width="*" />
                  <DataGridTextColumn Header="提醒" Binding="{Binding ReminderDisplay}" Width="150" />
                  <DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="ItemsEmptyState" Text="当前没有匹配的待办"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"
                         IsHitTestVisible="False" />
            </Grid>
          </Border>
          <Button x:Name="OpenItemButton" Grid.Row="2" Content="打开所在便利贴" HorizontalAlignment="Right" Margin="0,14,0,0" Click="OpenItem_Click" />
        </Grid>
      </TabItem>

      <TabItem Header="已完成归档" Tag="&#xE7B8;" Style="{StaticResource SideNavTabStyle}">
        <Grid Margin="26,22,26,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="已完成归档" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="清理后的事项仍可搜索和恢复" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
          </StackPanel>
          <Border Grid.Row="1" Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  CornerRadius="11" ClipToBounds="True" Background="White">
            <Grid>
              <DataGrid x:Name="ArchiveGrid" SelectionChanged="GridSelection_Changed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="原便利贴" Binding="{Binding NoteTitle}" Width="180" />
                  <DataGridTextColumn Header="事项" Binding="{Binding Text}" Width="*" />
                  <DataGridTextColumn Header="归档时间" Binding="{Binding ArchivedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="ArchiveEmptyState" Text="还没有归档事项"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"
                         IsHitTestVisible="False" />
            </Grid>
          </Border>
          <Button x:Name="RestoreArchiveButton" Grid.Row="2" Content="恢复到便利贴" HorizontalAlignment="Right" Margin="0,14,0,0" Click="RestoreArchive_Click" />
        </Grid>
      </TabItem>

      <TabItem Header="回收站" Tag="&#xE74D;" Style="{StaticResource SideNavTabStyle}">
        <Grid Margin="26,22,26,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="回收站" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="删除的便利贴保留 30 天，之后自动永久清理" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
          </StackPanel>
          <Border Grid.Row="1" Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  CornerRadius="11" ClipToBounds="True" Background="White">
            <Grid>
              <DataGrid x:Name="TrashGrid" SelectionChanged="GridSelection_Changed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*" />
                  <DataGridTextColumn Header="类型" Binding="{Binding KindDisplay}" Width="100" />
                  <DataGridTextColumn Header="删除时间" Binding="{Binding DeletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="TrashEmptyState" Text="回收站是空的"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"
                         IsHitTestVisible="False" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RestoreNoteButton" Content="恢复便利贴" Click="RestoreNote_Click" />
            <Button x:Name="PermanentDeleteNoteButton" Content="永久删除" Style="{StaticResource DangerButtonStyle}" Click="PermanentDeleteNote_Click" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="设置" Tag="&#xE713;" Style="{StaticResource SideNavTabStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,24" MaxWidth="650" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="启动、备份与隐私偏好" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,22" />

            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="启动与提醒" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <CheckBox x:Name="StartupCheckBox" Content="登录 Windows 后自动启动并驻留托盘"
                          Margin="0,13,0,0" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />
              </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="数据备份" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="BackupPathText" Margin="0,8,0,12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Content="立即备份" Click="BackupNow_Click" Style="{StaticResource PrimaryButtonStyle}" />
                  <Button Content="导出备份…" Click="ExportBackup_Click" />
                  <Button Content="从备份恢复…" Click="RestoreBackup_Click" />
                </WrapPanel>
                <TextBlock x:Name="SettingsStatusText" Margin="4,10,0,0" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Padding="18">
              <StackPanel>
                <TextBlock Text="隐私" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="应用只读写当前用户目录中的本地数据库，不包含云同步、账号、遥测或自动联网更新。"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
